# ═══════════════════════════════════════════════
#   GMAIL CREDENTIALS
# ═══════════════════════════════════════════════
GMAIL_ID=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# ═══════════════════════════════════════════════
#   GROQ AI RELEVANCE CHECK
# ═══════════════════════════════════════════════
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
AI_RELEVANCE_THRESHOLD=60
# role_quality  = role/candidate/recruiter quality; location is ignored
# role_location = same checks plus USA/US-remote requirement
# strict        = also enforce candidate skills and experience
AI_MATCH_MODE=role_quality
# direct_employer_only rejects all staffing/placement/third-party agencies.
RECRUITER_POLICY=direct_employer_only
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_COMPLETION_TOKENS=1000
# Send roughly half of each post, capped to the main 4000 characters.
GROQ_JOB_DESCRIPTION_RATIO_PERCENT=50
GROQ_JOB_DESCRIPTION_MAX_CHARS=4000

# ═══════════════════════════════════════════════
#   CANDIDATE INFO
# ═══════════════════════════════════════════════
CANDIDATE_NAME=Your Name
CANDIDATE_EMAIL=your-email@gmail.com
CANDIDATE_PHONE=+1 XXX-XXX-XXXX
CANDIDATE_LINKEDIN=https://www.linkedin.com/in/your-profile
CANDIDATE_LOCATION=San Francisco, CA
CANDIDATE_RELOCATION=Yes
CANDIDATE_WORK_AUTH=STEM OPT
CANDIDATE_AVAILABILITY=Immediate
CANDIDATE_EXPERIENCE=2+ Years
# AI may approve jobs requiring up to this many years; higher minimums are rejected.
MAX_EXPERIENCE_YEARS=5
CANDIDATE_RATE=Open (C2C)

# ═══════════════════════════════════════════════
#   RESUME - put your PDF in output/ folder
# ═══════════════════════════════════════════════
RESUME_FILENAME=Your_Name_Resume.pdf

# ═══════════════════════════════════════════════
#   CC AND BCC
# ═══════════════════════════════════════════════
CC_EMAILS=your-email@gmail.com
BCC_EMAILS=

# ═══════════════════════════════════════════════
#   BOT SETTINGS
#   Limit counts successfully sent emails across the complete run.
# ═══════════════════════════════════════════════
TARGET_EMAILS_PER_RUN=20
MAX_EMAILS_PER_RUN=30
# Used only when RECRUITER_POLICY=hybrid_quality.
MAX_AGENCY_EMAIL_PERCENT=20
# Process this many unique linked posts per role when 24h results allow it.
POSTS_PER_ROLE=30
# Safety ceiling; normal stop is 30 posts or no new linked posts twice.
MAX_PASSES_PER_ROLE=30
NO_NEW_POST_PASSES=2
# Pace AI calls to avoid Groq request/token-per-minute limits.
DELAY_BETWEEN_AI_REQUESTS=15
GROQ_RATE_LIMIT_COOLDOWN_SECONDS=60
GROQ_MAX_RATE_LIMIT_WAIT_SECONDS=300
# Never block the automation for several minutes on one AI request.
GROQ_MAX_BLOCKING_WAIT_SECONDS=30
# Reject accidental combined-page containers before they cause oversized AI calls.
MAX_EMAILS_PER_POST=5
MAX_JOB_DESCRIPTION_CHARS=12000
DELAY_BETWEEN_EMAILS=12
SCROLL_ROUNDS=8
WAIT_BETWEEN_ROLES_MIN=60
WAIT_BETWEEN_ROLES_MAX=120

# ═══════════════════════════════════════════════
#   ROLES
#   ROLE_N_NAME   = preferred role title shown in email and sent to Groq
#   ROLE_N_SKILLS = candidate skills mentioned in email and sent to Groq
#   ROLE_N_SEARCH = query used for the LinkedIn search
# ═══════════════════════════════════════════════

ROLE_1_NAME=Data Analyst
ROLE_1_SKILLS=Python, SQL, Power BI, Azure
ROLE_1_SEARCH=Data Analyst hiring email


ROLE_2_NAME=Business Analyst
ROLE_2_SKILLS=Agile, JIRA, SQL, Stakeholder Management
ROLE_2_SEARCH=Business Analyst hiring email


ROLE_3_NAME=Business Intelligence Analyst
ROLE_3_SKILLS=SQL, Power BI, Tableau, Data Visualization
ROLE_3_SEARCH=Business Intelligence Analyst hiring email


ROLE_4_NAME=Operations Analyst
ROLE_4_SKILLS=SQL, Excel, Data Analysis, Operations Management
ROLE_4_SEARCH=Operations Analyst hiring email


ROLE_5_NAME=Business Operations Analyst
ROLE_5_SKILLS=Excel, SQL, Data Analysis, Process Improvement
ROLE_5_SEARCH=Business Operations Analyst hiring email


ROLE_6_NAME=Product Analyst
ROLE_6_SKILLS=SQL, Python, Product Analytics, A/B Testing
ROLE_6_SEARCH=Product Analyst hiring email


ROLE_7_NAME=Reporting Analyst
ROLE_7_SKILLS=SQL, Power BI, Excel, Reporting
ROLE_7_SEARCH=Reporting Analyst hiring email


ROLE_8_NAME=Data Operations Analyst
ROLE_8_SKILLS=Azure, Scrum, IAM
ROLE_8_SEARCH=Data Operations Analyst hiring email


ROLE_9_NAME=Analytics Consultant
ROLE_9_SKILLS=SQL, Python, Power BI, Data Analytics
ROLE_9_SEARCH=Analytics Consultant hiring email


ROLE_10_NAME=Strategy Analyst
ROLE_10_SKILLS=SQL, Excel, Data Analysis, Strategic Planning
ROLE_10_SEARCH=Strategy Analyst hiring email

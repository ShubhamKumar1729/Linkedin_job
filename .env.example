# ═══════════════════════════════════════════════
#   GMAIL CREDENTIALS
# ═══════════════════════════════════════════════
GMAIL_ID=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# ═══════════════════════════════════════════════
#   GROQ AI RELEVANCE CHECK
# ═══════════════════════════════════════════════
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
AI_RELEVANCE_THRESHOLD=70
# role_location = match target role + USA location + genuine-looking recruiter
# strict        = also enforce candidate skills and experience
AI_MATCH_MODE=role_location
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2

# ═══════════════════════════════════════════════
#   CANDIDATE INFO
# ═══════════════════════════════════════════════
CANDIDATE_NAME=Your Name
CANDIDATE_EMAIL=your-email@gmail.com
CANDIDATE_PHONE=+1 XXX-XXX-XXXX
CANDIDATE_LINKEDIN=https://www.linkedin.com/in/your-profile
CANDIDATE_LOCATION=San Francisco, CA
CANDIDATE_RELOCATION=Yes
CANDIDATE_WORK_AUTH=STEM OPT
CANDIDATE_AVAILABILITY=Immediate
CANDIDATE_EXPERIENCE=2+ Years
CANDIDATE_RATE=Open (C2C)

# ═══════════════════════════════════════════════
#   RESUME - put your PDF in output/ folder
# ═══════════════════════════════════════════════
RESUME_FILENAME=Your_Name_Resume.pdf

# ═══════════════════════════════════════════════
#   CC AND BCC
# ═══════════════════════════════════════════════
CC_EMAILS=your-email@gmail.com
BCC_EMAILS=

# ═══════════════════════════════════════════════
#   BOT SETTINGS
#   Limit counts successfully sent emails across the complete run.
# ═══════════════════════════════════════════════
MAX_EMAILS_PER_RUN=50
DELAY_BETWEEN_EMAILS=12
SCROLL_ROUNDS=8
# Build a quoted role + USA Boolean query instead of using noisy raw searches.
AUTO_BUILD_ROLE_SEARCH=true
WAIT_BETWEEN_ROLES_MIN=60
WAIT_BETWEEN_ROLES_MAX=120

# ═══════════════════════════════════════════════
#   ROLES
#   ROLE_N_NAME   = preferred role title shown in email and sent to Groq
#   ROLE_N_SKILLS = candidate skills mentioned in email and sent to Groq
#   ROLE_N_SEARCH = query used for the LinkedIn search
# ═══════════════════════════════════════════════

ROLE_1_NAME=Data Analyst
ROLE_1_SKILLS=Python, SQL, Power BI, Azure
ROLE_1_SEARCH=Data Analyst us -hotlist-benchsales-c2c


ROLE_2_NAME=Business Analyst
ROLE_2_SKILLS=Agile, JIRA, SQL, Stakeholder Management
ROLE_2_SEARCH=Business Analyst us -hotlist-benchsales-c2c


ROLE_3_NAME=Business Intelligence Analyst
ROLE_3_SKILLS=SQL, Power BI, Tableau, Data Visualization
ROLE_3_SEARCH=Business Intelligence Analyst us -hotlist-benchsales-c2c


ROLE_4_NAME=Operations Analyst
ROLE_4_SKILLS=SQL, Excel, Data Analysis, Operations Management
ROLE_4_SEARCH=Operations Analyst us -hotlist-benchsales-c2c


ROLE_5_NAME=Business Operations Analyst
ROLE_5_SKILLS=Excel, SQL, Data Analysis, Process Improvement
ROLE_5_SEARCH=Business Operations Analyst us -hotlist-benchsales-c2c


ROLE_6_NAME=Product Analyst
ROLE_6_SKILLS=SQL, Python, Product Analytics, A/B Testing
ROLE_6_SEARCH=Product Analyst us -hotlist-benchsales-c2c


ROLE_7_NAME=Reporting Analyst
ROLE_7_SKILLS=SQL, Power BI, Excel, Reporting
ROLE_7_SEARCH=Reporting Analyst us -hotlist-benchsales-c2c


ROLE_8_NAME=Data Operations Analyst
ROLE_8_SKILLS=Azure, Scrum, IAM
ROLE_8_SEARCH=Data Operations Analyst us -hotlist-benchsales-c2c


ROLE_9_NAME=Analytics Consultant
ROLE_9_SKILLS=SQL, Python, Power BI, Data Analytics
ROLE_9_SEARCH=Analytics Consultant us -hotlist-benchsales-c2c


ROLE_10_NAME=Strategy Analyst
ROLE_10_SKILLS=SQL, Excel, Data Analysis, Strategic Planning
ROLE_10_SEARCH=Strategy Analyst us -hotlist-benchsales-c2c
